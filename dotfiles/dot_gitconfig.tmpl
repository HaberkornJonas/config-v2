[user]
	name = {{ .git_user_name }}
	email = {{ .git_user_email }}
{{- if .gpg_fingerprint }}
	signingkey = {{ .gpg_fingerprint }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
{{- $gpg := lookPath "gpg" }}
{{- if $gpg }}
[gpg]
	# GUI apps on macOS do not get the shell PATH, so pin the gpg binary found at apply time.
	program = {{ $gpg }}
{{- end }}
{{- end }}
[init]
	defaultBranch = main
[core]
	editor = nvim
[alias]
	undo = reset --soft HEAD~1
	delprev = "!f() { git branch -D @{-1}; }; f"
	maid = "!git gc --aggressive && git fetch --prune && git branch -vv | grep 'gone]' | awk '{print $1}' | xargs -r git branch -D"
